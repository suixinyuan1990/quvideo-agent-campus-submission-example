# 无需配置。不创建 .env、也不填写下面的值时，项目使用本地观察决策模型，不访问网络。
# 全部示例和测试都可以在这种状态下运行。

# 仅当命令行传入 --model llm 时需要：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# 可选上限。请求 JSON 和命令行参数优先于环境变量。
# AGENT_MAX_STEPS=8
# AGENT_MAX_TOOL_CALLS=8

# 可选。默认从当前工作目录或仓库根目录定位 data/。
# SCHEDULING_AGENT_ROOT=
